{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  // Hide OpenCode's built-in direct-to-ollama.com provider; cloud tags go through local Ollama below.
  "disabled_providers": ["ollama-cloud"],
  // Compaction is global (not per model). keep.tokens is lowered from the 15000 default so a
  // local-model compaction lands at ~18K (8.6K system+tools, summary, 8K tail), not back at the
  // 32K threshold. Threshold itself = limit.context - max(15%, 16K); see each model's limit.
  "compaction": { "auto": true, "keep": { "tokens": 8000 } },
  // Cap what a single tool result can add to the context. The 51200-byte default let one
  // `curl index.yaml | head -20` add 14.5K tokens in a turn; the full output is still saved to
  // disk, only the transcript copy is truncated. NOTE: OpenCode 2.2.6 does not know this key and
  // drops it silently (`opencode debug config` shows it missing) — it takes effect after an upgrade.
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  // Default: fast local MoE. Switch with /models or `opencode --model ollama/<tag>`.
  "model": "ollama/qwen3.6:35b-a3b-coding-nvfp4",
  "provider": {
    // One provider for both local and cloud: `:cloud` tags are routed by the
    // local Ollama server to ollama.com (needs `ollama signin` once).
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        // ---- local (MLX NVFP4, M5 Max 48 GB) ----
        // 35B MoE, 3B active — fast daily driver, 24 GB.
        "qwen3.6:35b-a3b-coding-nvfp4": {
          "name": "Local · Qwen3.6 35B-A3B Coding (fast)",
          // 49152 - 16K compaction buffer => auto-compact at 32K. 42K context pushed the
          // runner to 30 GB resident with 19 GB compressed (2026-11-10), so 32K is the cap.
          "limit": { "context": 49152, "output": 8192 }
        },
        // 27B dense — stronger, ~3-4x slower, 18 GB.
        "qwen3.8:27b-nvfp4": {
          "name": "Local · Qwen3.8 27B (quality)",
          "limit": { "context": 49152, "output": 8192 }
        },
        // ---- cloud (pay per token via ollama.com) ----
        // Main cloud coder: best agentic scores, $0.30/$1.20 per 1M.
        "deepseek-v4.1-flash:cloud": {
          "name": "Cloud · DeepSeek V4.1 Flash (main)",
          "limit": { "context": 1000000, "output": 65536 }
        },
        // Cheapest coder: $0.15/$0.60 per 1M.
        "minimax-m3.1-flash:cloud": {
          "name": "Cloud · MiniMax M3.1 Flash (cheap)",
          "limit": { "context": 976000, "output": 65536 }
        },
        // Hardest tasks: $1.32/$3.96, half price off-peak (outside 12–18 UTC weekdays = Thai daytime).
        "deepseek-v4-pro:cloud": {
          "name": "Cloud · DeepSeek V4 Pro (heavy)",
          "limit": { "context": 1000000, "output": 65536 }
        },
        // Best open-weights coder for long-horizon agent work: $1.40/$4.40 per 1M.
        // Needs an Ollama Pro plan ("larger pro models"). reasoning_effort: low|high|max, defaults to max.
        "glm-5.3:cloud": {
          "name": "Cloud · GLM-5.3 (best coder)",
          "limit": { "context": 1000000, "output": 65536 }
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_AUTH_METHOD": "ssh",
        "GITHUB_SSH_PRIVATE_KEY_PATH": "/Users/nenoteerawat/.ssh/pttep_gh_id"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "mcp-docker-server"]
    },
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubectl-mcp-server"]
    }
  }
}
