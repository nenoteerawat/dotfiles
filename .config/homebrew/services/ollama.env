# Env overrides for the `brew services` ollama LaunchAgent (sh.brew.ollama). KEY=value per line.
# brew regenerates ~/Library/LaunchAgents/sh.brew.ollama.plist from the formula on every
# start/restart, so hand-edits to the plist are lost (happened 2026-11-10). This file is the
# supported hook: $HOMEBREW_USER_CONFIG_HOME/services/<formula>.env — and because XDG_CONFIG_HOME
# is set, that is ~/.config/homebrew/services/, NOT ~/.homebrew/. Applied on the next
# `brew services restart ollama`; verify with `ps -wwE -p $(pgrep -x ollama | head -1) -o command=`.
# Must not be group/world-writable or brew skips it.
#
# Keep the model resident between OpenCode turns. The 5m default unloaded it twice on 2026-11-10
# and each reload re-prefilled a 43K-token prompt from a cold cache.
OLLAMA_KEEP_ALIVE=1h
# One request / one model at a time: a second 24 GB model or a parallel KV cache does not fit
# next to Docker Desktop on 48 GB.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Server default context. NOTE: the MLX engine does not truncate to this (42,879-token prompts
# went through under 32768); the real cap is OpenCode's limit.context + compaction.
OLLAMA_CONTEXT_LENGTH=32768
